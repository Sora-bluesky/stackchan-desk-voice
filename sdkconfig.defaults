# ---- target / memory ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- safety ----
CONFIG_ESP_BROWNOUT_DET=y

# ---- console on Grove PORT.C: TX=G17 / RX=G18, 115200 ----
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=17
CONFIG_ESP_CONSOLE_UART_RX_GPIO=18
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- USB Audio Class: 48 kHz / 16 bit / mic 1ch / spk 1ch, Windows ----
CONFIG_UAC_TUSB_VID=0x303A
CONFIG_UAC_TUSB_PID=0x8000
CONFIG_UAC_TUSB_MANUFACTURER="M5Stack-StackChan(custom)"
CONFIG_UAC_TUSB_PRODUCT="StackChan"
CONFIG_UAC_TUSB_SERIAL_NUM="SC-DESKVOICE-01"
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SPEAKER_CHANNEL_NUM=1
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_SPK_INTERVAL_MS=10
CONFIG_UAC_SUPPORT_MACOS=n
# Core 0 = USB/audio, Core 1 = face/servo
CONFIG_UAC_TINYUSB_TASK_CORE=0
CONFIG_UAC_SPK_TASK_CORE=0
CONFIG_UAC_MIC_TASK_CORE=0
CONFIG_UAC_TINYUSB_TASK_PRIORITY=8
CONFIG_UAC_SPK_TASK_PRIORITY=7
CONFIG_UAC_MIC_TASK_PRIORITY=7

# ---- neck servos: on ----
CONFIG_STACKCHAN_SERVO=y
